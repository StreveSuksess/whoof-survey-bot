[Unit]
Description=Whoof survey Google Sheets synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=whoof-survey
Group=whoof-survey
WorkingDirectory=/opt/whoof-survey/results
EnvironmentFile=/etc/whoof-sheets-sync.env
ExecStart=/opt/whoof-survey/results/venv/bin/python /opt/whoof-survey/results/direct_sync.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/whoof-survey
TimeoutStartSec=240
